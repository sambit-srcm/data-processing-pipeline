# Process configuration for the API server.
# Copy to .env for local notes; the app reads real environment variables only.

# HTTP listen address
HTTP_ADDR=:8080

# Worker pool sizes (must be >= 1)
VALIDATION_WORKERS=5
TRANSFORM_WORKERS=5

# Pipeline channel buffer sizes (must be >= 0)
RECORDS_BUFFER=100
VALIDATED_BUFFER=100
TRANSFORMED_BUFFER=100
ERRORS_BUFFER=100
PROGRESS_BUFFER=100
